# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹) 의 SDK 설정값을 복사해 .env 로 저장하세요.
# (이 값들은 클라이언트에 공개되는 값이며, 접근 제어는 database.rules.json 으로 합니다.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 로컬 에뮬레이터로 개발할 때만 1 (Firebase 계정 없이 테스트 가능, README 참고)
# VITE_FIREBASE_EMULATOR=1
# 폰에서 PC 의 에뮬레이터에 붙을 때 PC 의 LAN 주소 (비우면 접속한 호스트명을 그대로 사용)
# VITE_FIREBASE_EMULATOR_HOST=
